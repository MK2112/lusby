# AppArmor profile for lusby-daemon
#include <tunables/global>

profile /usr/sbin/lusby-daemon flags=(complain) {
  include <abstractions/base>

  # Binary execution
  /usr/sbin/lusby-daemon rmix,
  /usr/bin/usbguard ix,

  # Configuration and baselines
  /etc/lusby/ r,
  /etc/lusby/** rw,
  /etc/usbguard/rules.conf r,
  /etc/usbguard/rules.conf.tmp rw,
  /etc/usbguard/rules.conf.bak rw,

  # Logs and state
  /var/log/lusby/ rw,
  /var/log/lusby/** rw,
  /var/lib/lusby/ rw,
  /var/lib/lusby/** rw,

  # D-Bus system access
  /run/dbus/system_bus_socket rw,
  /sys/fs/cgroup/systemd/system.slice/lusby-daemon.service/cgroup.procs rw,

  # USB device information (for listing devices)
  /sys/bus/usb/** r,
  /sys/class/usb/** r,
  @{PROC}/@{pid}/cmdline r,
  @{PROC}/@{pid}/fd/ r,

  # Required capabilities
  capability sys_admin,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability fsetid,
}
