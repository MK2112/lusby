[Unit]
Description=Lusby Daemon - USB Device Access Control
Documentation=man:lusby-daemon(8)
After=network.target dbus.service usbguard.service
Wants=usbguard.service

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/lusby-daemon

# Restart policy for robustness
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Hardening (daemon only needs its own dirs, usbguard rules, and the system bus)
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/usbguard /etc/lusby /var/log/lusby /var/lib/lusby
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lusby-daemon

[Install]
WantedBy=multi-user.target
