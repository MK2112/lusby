[Unit]
Description=Lusby Daemon - USB Device Access Control
Documentation=man:lusby-daemon(8)
After=network.target dbus.service usbguard.service
Wants=usbguard.service

[Service]
Type=simple
User=root
ExecStart=/usr/sbin/lusby-daemon

# Restart policy for robustness
Restart=on-failure
RestartSec=2
RestartForceExitStatus=1 2 3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lusby-daemon

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no
UMask=0077

[Install]
WantedBy=multi-user.target
